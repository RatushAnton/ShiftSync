<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/medical_blue"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_logo_hospital"
        android:layout_marginBottom="16dp"
        app:tint="@color/white"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShiftSync"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="48dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Portal"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/medical_dark"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/loginEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email Address"
                android:background="@android:color/transparent"
                android:drawableStart="@android:drawable/sym_action_email"
                android:drawablePadding="12dp"
                android:drawableTint="@color/medical_blue"
                android:inputType="textEmailAddress"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/loginPass"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Password"
                android:background="@android:color/transparent"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="12dp"
                android:drawableTint="@color/medical_blue"
                android:inputType="textPassword"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Secure Login"
                android:backgroundTint="@color/medical_dark"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/goToRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Staff? Register Here"
                android:gravity="center"
                android:paddingTop="16dp"
                android:textColor="@color/medical_blue"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>